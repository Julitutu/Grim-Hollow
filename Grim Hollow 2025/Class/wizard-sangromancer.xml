<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Sangromancer</name>
		<description>The Sangromancer subclass from Grim Hollow: Player's Guide (2025).</description>
		<author url="https://ghostfiregaming.com/">Ghostfire Gaming</author>
		<update version="0.0.1">
			<file name="wizard-sangromancer.xml" url="https://raw.githubusercontent.com/Julitutu/Grim-Hollow/refs/heads/main/Grim-Hollow-2025/Class/wizard-sangromancer.xml" />
		</update>
	</info>

	<element name="Sangromancer" type="Archetype" source="Grim Hollow: Player's Guide (2025)" id="ID_GFG_GHPG25_ARCHETYPE_WIZARD_SANGROMANCER">
		<supports>Wizard Subclass</supports>
		<description>
			<p class="flavor">Spill Blood for Power</p>
			<p>You study an uncommon school of magic known as Sangromancy or blood magic. Despite its dark reputation, there's nothing inherently evil about the practice of Sangromancy, though its demands on its practitioners are gruesome.</p>
			<p class="indent">As a Sangromancer, your chosen magic demands more than knowledge: it demands sacrifice. Other Wizards may view you with skepticism or even outright hostility, but none can deny the potency of your art.</p>
			<div element="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_SAVANT" />
			<div element="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_FULL_BLOODED" />
			<div element="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_SANGUINE_VIGOR" />
			<div element="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_BLOOD_FOR_BLOOD" />
			<div element="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_RED_RENEWAL" />
		</description>
		<sheet display="false" />
		<spellcasting name="Wizard" extend="true">
			<extend>ID_GFG_GHPG25_SPELL_BLOODBANE_RUNE</extend>
			<extend>ID_GFG_GHPG25_SPELL_BLOOD_BOND</extend>
			<extend>ID_GFG_GHPG25_SPELL_BLOOD_RUSH</extend>
			<extend>ID_GFG_GHPG25_SPELL_BOIL_BLOOD</extend>
			<extend>ID_GFG_GHPG25_SPELL_CIRCLE_OF_SCARLET</extend>
			<extend>ID_GFG_GHPG25_SPELL_MORTALITY</extend>
			<extend>ID_GFG_GHPG25_SPELL_REANIMATE</extend>
			<extend>ID_GFG_GHPG25_SPELL_RED_RAIN</extend>
			<extend>ID_GFG_GHPG25_SPELL_SANGUINE_POPPET</extend>
			<extend>ID_GFG_GHPG25_SPELL_SENSE_LIFEBLOOD</extend>
			<extend>ID_GFG_GHPG25_SPELL_SOMNOLENCE</extend>
			<extend>ID_GFG_GHPG25_SPELL_SPLATTERING_SMITE</extend>
			<extend>ID_GFG_GHPG25_SPELL_STEAL_IMMORTALITY</extend>
			<extend>ID_GFG_GHPG25_SPELL_WILTING_SMITE</extend>
		</spellcasting>
		<rules>
			<grant type="Archetype Feature" id="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_SAVANT" level="3" />
			<grant type="Archetype Feature" id="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_FULL_BLOODED" level="3" />
			<grant type="Archetype Feature" id="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_SANGUINE_VIGOR" level="6" />
			<grant type="Archetype Feature" id="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_BLOOD_FOR_BLOOD" level="10" />
			<grant type="Archetype Feature" id="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_RED_RENEWAL" level="14" />
		</rules>
	</element>

	<element name="Level 3: Sangromancy Savant" type="Archetype Feature" source="Grim Hollow: Player's Guide (2025)" id="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_SAVANT">
		<requirements>!ID_INTERNAL_GHPG25_FEATURE_REPLACEMENT_SANGROMANCER_SAVANT</requirements>
		<description>
			<p>Sangromancy spells count as Wizard spells for you. Choose two Sangromancy spells, each of which must be no higher than level 2, and add them to your spellbook for free.</p>
			<p class="indent">In addition, whenever you gain access to a new level of spell slots in this class, you can add one Sangromancy spell to your spellbook for free. The chosen spell must be of a level for which you have spell slots.</p>
		</description>
		<sheet display="false" />
		<rules>
			<select type="Spell" name="Sangromancy Spell (Savant)" supports="$(spellcasting:slots), Sangromancy" number="2" level="3" spellcasting="Wizard" />
			<select type="Spell" name="Sangromancy Spell (Savant)" supports="$(spellcasting:slots), Sangromancy" level="5" spellcasting="Wizard" />
			<select type="Spell" name="Sangromancy Spell (Savant)" supports="$(spellcasting:slots), Sangromancy" level="7" spellcasting="Wizard" />
			<select type="Spell" name="Sangromancy Spell (Savant)" supports="$(spellcasting:slots), Sangromancy" level="9" spellcasting="Wizard" />
			<select type="Spell" name="Sangromancy Spell (Savant)" supports="$(spellcasting:slots), Sangromancy" level="11" spellcasting="Wizard" />
			<select type="Spell" name="Sangromancy Spell (Savant)" supports="$(spellcasting:slots), Sangromancy" level="13" spellcasting="Wizard" />
			<select type="Spell" name="Sangromancy Spell (Savant)" supports="$(spellcasting:slots), Sangromancy" level="15" spellcasting="Wizard" />
			<select type="Spell" name="Sangromancy Spell (Savant)" supports="$(spellcasting:slots), Sangromancy" level="17" spellcasting="Wizard" />
		</rules>
	</element>

	<element name="Level 3: Full-Blooded" type="Archetype Feature" source="Grim Hollow: Player's Guide (2025)" id="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_FULL_BLOODED">
		<requirements>!ID_INTERNAL_GHPG25_FEATURE_REPLACEMENT_SANGROMANCER_FULL_BLOODED</requirements>
		<description>
			<p>You draw magic from blood. It is represented by your Sangromancy Dice, which fuel powers you have from this subclass. You have a pool of d12s that you can expend instead of a Hit Die when you cast Sangromancy spells. The number of dice in the pool equals 1 plus your Wizard level. You regain one expended Sangromancy Die when you finish a Short Rest, and you regain all expended Sangromancy Dice when you finish a Long Rest.</p>
		</description>
		<sheet alt="Full-Blooded" usage="{{full blooded:pool}}d12/Long Rest">
			<description>You can expend Sangromancy Dice instead of Hit Dice when you cast Sangromancy spells. Regain 1 on a Short Rest.</description>
		</sheet>
		<rules>
			<stat name="full blooded:pool" value="1" />
			<stat name="full blooded:pool" value="level:wizard" />
		</rules>
	</element>

	<element name="Level 6: Sanguine Vigor" type="Archetype Feature" source="Grim Hollow: Player's Guide (2025)" id="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_SANGUINE_VIGOR">
		<requirements>!ID_INTERNAL_GHPG25_FEATURE_REPLACEMENT_SANGROMANCER_SANGUINE_VIGOR</requirements>
		<description>
			<p>Your Hit Point maximum increases by 6, and it increases by 1 whenever you gain another Wizard level. In addition, whenever you cast a Sangromancy spell with a spell slot, you regain Hit Points equal to the level of the spell slot.</p>
		</description>
		<sheet alt="Sanguine Vigor">
			<description>Whenever you cast a Sangromancy spell with a spell slot, you regain HP equal to the level of the spell slot.</description>
		</sheet>
		<rules>
			<stat name="hp" value="level:wizard" />
		</rules>
	</element>

	<element name="Level 10: Blood for Blood" type="Archetype Feature" source="Grim Hollow: Player's Guide (2025)" id="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_BLOOD_FOR_BLOOD">
		<requirements>!ID_INTERNAL_GHPG25_FEATURE_REPLACEMENT_SANGROMANCER_BLOOD_FOR_BLOOD</requirements>
		<description>
			<p>Once on each of your turns when you deal damage to one or more creatures with a Wizard spell you cast, you can spend a Hit Point Die or a Sangromancy Die, roll the die, and deal extra damage to one of those creatures equal to the roll. If the creature is Bloodied, you can roll twice and use the higher of the two rolls.</p>
		</description>
		<sheet alt="Blood for Blood" usage="1/Turn">
			<description>When you deal damage with a Wizard spell, you can spend a Hit Die or Sangromancy Die to deal extra damage equal to the roll to one creature. If the creature is Bloodied, roll twice and use the higher roll.</description>
		</sheet>
	</element>

	<element name="Level 14: Red Renewal" type="Archetype Feature" source="Grim Hollow: Player's Guide (2025)" id="ID_GFG_GHPG25_ARCHETYPE_FEATURE_SANGROMANCER_RED_RENEWAL">
		<requirements>!ID_INTERNAL_GHPG25_FEATURE_REPLACEMENT_SANGROMANCER_RED_RENEWAL</requirements>
		<description>
			<p>When you finish a Short Rest, you regain expended Hit Point Dice and Sangromancy Dice equal to half your Wizard level.</p>
			<p class="indent">Once you use this feature, you can't use it again until you finish a Long Rest.</p>
		</description>
		<sheet alt="Red Renewal" usage="1/Long Rest">
			<description>When you finish a Short Rest, you regain {{level:wizard:half}} expended Hit Dice and Sangromancy Dice.</description>
		</sheet>
	</element>

	<!--Feature Replacement Grants-->
	<element name="Sangromancy Savant Feature Replacement" type="Grants" source="Internal" id="ID_INTERNAL_GHPG25_FEATURE_REPLACEMENT_SANGROMANCER_SAVANT" />
	<element name="Full-Blooded Feature Replacement" type="Grants" source="Internal" id="ID_INTERNAL_GHPG25_FEATURE_REPLACEMENT_SANGROMANCER_FULL_BLOODED" />
	<element name="Sanguine Vigor Feature Replacement" type="Grants" source="Internal" id="ID_INTERNAL_GHPG25_FEATURE_REPLACEMENT_SANGROMANCER_SANGUINE_VIGOR" />
	<element name="Blood for Blood Feature Replacement" type="Grants" source="Internal" id="ID_INTERNAL_GHPG25_FEATURE_REPLACEMENT_SANGROMANCER_BLOOD_FOR_BLOOD" />
	<element name="Red Renewal Feature Replacement" type="Grants" source="Internal" id="ID_INTERNAL_GHPG25_FEATURE_REPLACEMENT_SANGROMANCER_RED_RENEWAL" />

</elements>